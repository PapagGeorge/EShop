{
  "info": {
    "name": "EShop API",
    "description": "E-Commerce Order Management System - API Collection\n\nAll requests go through the API Gateway at localhost:5000.\n\nWorkflow: Register → Login → Create Order → Get Order → Cancel Order",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Identity Service - Authentication endpoints",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"MyPassword123\",\n  \"fullName\": \"George Papag\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user account. Returns user ID and email."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"MyPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login and receive a JWT token. The token is automatically saved to the collection variable for use in subsequent requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "description": "Catalog Service - Product endpoints (no auth required)",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Get all available products from the catalog."
          },
          "response": []
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/a1b2c3d4-0001-0001-0001-000000000001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "a1b2c3d4-0001-0001-0001-000000000001"]
            },
            "description": "Get a single product by its ID."
          },
          "response": []
        },
        {
          "name": "Get Products Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  \"a1b2c3d4-0001-0001-0001-000000000001\",\n  \"a1b2c3d4-0002-0002-0002-000000000002\"\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/batch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "batch"]
            },
            "description": "Get multiple products by IDs (used internally by Ordering Service)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Ordering Service - Order management endpoints (requires JWT token)",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('orderId', jsonData.id);",
                  "    console.log('Order ID saved: ' + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"Athens\",\n    \"zipCode\": \"10431\",\n    \"country\": \"Greece\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"a1b2c3d4-0001-0001-0001-000000000001\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"a1b2c3d4-0002-0002-0002-000000000002\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Create a new order. Product details (name, price) are fetched from the Catalog Service. The order ID is automatically saved for use in subsequent requests."
          },
          "response": []
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            },
            "description": "Get order details by ID."
          },
          "response": []
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "cancel"]
            },
            "description": "Cancel a pending order. Only orders with status 'Pending' can be cancelled."
          },
          "response": []
        },
        {
          "name": "Get User Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "status",
                  "value": "Pending",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            },
            "description": "Get paginated list of user orders. Optional filter by status (Pending, Confirmed, Shipped, Delivered, Cancelled)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health Checks",
      "description": "Health check endpoints for all services",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/health",
              "host": ["http://localhost:5000"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Identity Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5213/health",
              "host": ["http://localhost:5213"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Ordering Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5281/health",
              "host": ["http://localhost:5281"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Catalog Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5056/health",
              "host": ["http://localhost:5056"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
